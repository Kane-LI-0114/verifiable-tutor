# Template for the local secret file. Copy to .env and fill in the keys.
# The real .env is ignored by Git; never commit it.
# Only secrets belong here: provider API keys, the SMTP authorization code,
# local tracing keys, and the session signing secret. Endpoints, model ids,
# and request parameters live in config/models.yaml; tracing settings live in
# config/observability.yaml (planned).

DEEPSEEK_API_KEY=
MIMO_API_KEY=

# Registration and password reset email (QQ Mail SMTP, see docs/email-local.md).
# SMTP_PASSWORD is the QQ Mail authorization code, never the QQ account password.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Local development tracing only (see docs/langfuse-local.md). Optional.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Signs the session cookie.
SESSION_SECRET=
