# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
# Secrets: .env is local only; .env.example is the committed template.
.env
.env.*
!.env.example
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# --- Data: tracked corpus and TACC results, ignored runtime state ---
# The course PDFs, their OCR output, the BGE-M3 index, and the Qwen knowledge
# records are tracked so a new checkout can rebuild the local knowledge store
# without re-running the TACC jobs. They are course material: keep the
# repository private and do not redistribute the PDFs or OCR text. The SQLite
# store, traces, model caches, and request/result scratch stay local.
data/app/*
!data/app/.gitkeep
data/caches/*
!data/caches/.gitkeep
data/corpus/*
!data/corpus/.gitkeep
!data/corpus/pdf/
!data/corpus/corpus-pdf/
!data/corpus/images/
!data/corpus/pages/
!data/corpus/ocr/
!data/corpus/pdf-parse/
data/index/*
!data/index/.gitkeep
!data/index/ingest.json
!data/index/row_map.jsonl
!data/index/summary.json
!data/index/vectors.npy
data/kb/*
!data/kb/.gitkeep
!data/kb/builds/
!data/kb/records/
logs/
slurm_log/
*.log
examples/output/
tmp/
scratch/

# --- Local model weights (runtime artifacts, never commit) ---
# BGE-M3 for query embedding and the OCR weight caches are downloaded at setup
# time into the checkout-local models/ directory, are several GB, and are never
# part of the source tree. The weight formats are ignored as well so a model
# copied anywhere in the checkout stays out of Git.
models/
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.onnx
*.gguf
*.h5

# --- Frontend dependencies and build output ---
node_modules/
src/verifiable_tutor/ui/static/

# --- Editors ---
.idea/
.vscode/
*.swp

# --- AI agent local state (session memory, logs; never commit) ---
.workbuddy/

# --- TACC task staging (shared scripts copied in at submit time) ---
tacc/*/_staged/
