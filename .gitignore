# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
# Secrets: .env is local only; .env.example is the committed template.
.env
.env.*
!.env.example
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# --- Generated / runtime artifacts (keep the directories, ignore their contents) ---
data/corpus/*
!data/corpus/.gitkeep
data/index/*
!data/index/.gitkeep
data/caches/*
!data/caches/.gitkeep
data/kb/*
!data/kb/.gitkeep
logs/
slurm_log/
*.log
examples/output/
tmp/
scratch/

# --- Frontend dependencies and build output ---
node_modules/
src/verifiable_tutor/ui/static/

# --- Editors ---
.idea/
.vscode/
*.swp

# --- TACC task staging (shared scripts copied in at submit time) ---
tacc/*/_staged/
