digraph components {
  graph [rankdir=LR, splines=ortho, nodesep=0.14, ranksep=0.26, fontname="Helvetica", fontsize=8,
         bgcolor="white", pad=0.04, compound=true, size="6.1,2.5"];
  node [fontname="Helvetica", fontsize=7, shape=box, style="rounded,filled", fillcolor="#f5f5f5",
        margin="0.05,0.025", height=0.26];
  edge [fontname="Helvetica", fontsize=6, color="#333333", arrowsize=0.45];

  ui [label="Web UI\nlive progress\nreplay mode", fillcolor="#e6e6e6"];

  subgraph cluster_cpu {
    label="TACC CPU job: agent backend"; fontsize=7.5; style="rounded"; color="#666666"; margin=6;
    gate  [label="Policy Gate\n+ deadline\nregistry"];
    orch  [label="Orchestrator\ncontext\nbudget"];
    ev    [label="Evidence\nhybrid retrieve\n+ span verify"];
    art   [label="Practice Lab\npack gen\n+ tests"];
    teach [label="Teaching\nexplainer"];
    mc    [label="Model Client\nTACC / external"];
    trace [label="Trace\nLogger"];
  }

  subgraph cluster_gpu {
    label="TACC GPU job"; fontsize=7.5; style="rounded"; color="#666666"; margin=6;
    serve [label="vLLM Qwen 27B\nINT4 TP=2\n32K ≤4", fillcolor="#e6e6e6"];
  }

  corpus [label="Course corpus\nPDF + OCR", shape=cylinder];
  index  [label="Dense + BM25\nindex", shape=cylinder];
  ext_s  [label="External\nsearch API\n(optional)", fillcolor="#ffffff"];
  ext_l  [label="External LLM\n(optional)", fillcolor="#ffffff"];
  evalh  [label="Evaluation\nharness", fillcolor="#ffffff"];

  ui -> gate [label="query"];
  gate -> orch [label="policy state"];
  orch -> ev;
  orch -> art;
  orch -> teach;
  ev -> index [dir=back];
  index -> corpus [dir=back];
  ev -> mc;
  art -> mc;
  teach -> mc;
  mc -> serve [label="chat"];
  mc -> ext_l [style=dashed, label="baseline"];
  ev -> ext_s [style=dashed, label="tiered"];
  ev -> trace [style=invis];
  gate -> trace [style=invis];
  trace -> evalh [label="traces"];
}
