digraph components_v2 {
  graph [rankdir=LR, splines=ortho, nodesep=0.16, ranksep=0.30, fontname="Helvetica", fontsize=8,
         bgcolor="white", pad=0.04, compound=true, newrank=true, size="6.1,2.5"];
  node [fontname="Helvetica", fontsize=7, shape=box, style="rounded,filled", fillcolor="#f5f5f5",
        margin="0.06,0.03", height=0.26];
  edge [fontname="Helvetica", fontsize=5.8, color="#333333", arrowsize=0.4];

  ui [label="Web UI\ntask input\nprogress\nreview", fillcolor="#e6e6e6"];

  subgraph cluster_laptop {
    label="Developer laptop: local backend and stores"; fontsize=7; style="rounded"; color="#666666"; margin=5;
    gate  [label="Policy gate\n+ deadline registry"];
    orch  [label="Orchestrator\ncontext budget"];
    ev    [label="Evidence\nhybrid retrieve\n+ span verify"];
    art   [label="Practice lab\npack gen + tests"];
    teach [label="Teaching\nexplainer"];
    mc    [label="Model client\nretries, cache"];
    trace [label="Trace\nlogger"];
  }

  subgraph cluster_ext {
    label="External APIs (HTTPS)"; fontsize=7; style="rounded"; color="#666666"; margin=5;
    ds   [label="DeepSeek API\nchat, search", fillcolor="#ffffff"];
    mimo [label="MiMo API\nchat, ASR, TTS", fillcolor="#ffffff"];
    ds -> mimo [style=invis];
  }

  subgraph cluster_tacc {
    label="TACC: offline batch jobs"; labeljust="r"; fontsize=7; style="rounded"; color="#666666"; margin=5;
    ocr    [label="OCR job\nPaddleOCR-VL", fillcolor="#ffffff"];
    index  [label="Index job\nBGE-M3 + FTS5", fillcolor="#ffffff"];
    exec   [label="Exec job\nMPI tests", fillcolor="#ffffff"];
    evalh  [label="Evaluation job\nbenchmarks", fillcolor="#ffffff"];
    userdir [label="USERDIR\nartifacts", shape=cylinder, fillcolor="#ffffff"];
    ocr -> index -> exec -> evalh [style=invis];
    { rank=same; evalh; userdir; }
  }

  files [label="local mirror\ncorpus, index,\ntraces, cache", shape=cylinder, fillcolor="#ffffff"];

  ui -> gate;
  gate -> orch;
  orch -> teach;
  orch -> art;
  orch -> ev;
  teach -> mc;
  art -> mc;
  ev -> mc;
  mc -> ds;
  mc -> mimo;
  trace -> files [style=dotted, arrowhead=none];
  files -> ev [style=dotted, dir=back];
  art -> exec;
  ocr -> userdir [style=dashed, arrowhead=none];
  index -> userdir [style=dashed, arrowhead=none];
  exec -> userdir [style=dashed, arrowhead=none];
  evalh -> userdir [style=dashed, arrowhead=none];
  userdir -> files [style=dotted, dir=back];
  trace -> evalh;
}
