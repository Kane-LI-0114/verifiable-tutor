  "info": {
    "description": "Local backend for the course-grounded tutoring agent: accounts, chat streaming and replay, knowledge cards and builds, corpus page images, and voice. TACC is reached only through submitted jobs; this API never exposes a TACC service.",
    "title": "Verifiable Tutor API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/login": {
      "post": {
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sign in and set the session cookie",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout_api_auth_logout_post",
        "responses": {
          "204": {
            "description": "Session cleared"
          }
        },
        "summary": "Sign out and clear the session cookie",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me": {
