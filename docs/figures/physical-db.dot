digraph physical_data_model {
  // Generated by scripts/build_data_model.py from the Storage schema; do not edit.
  graph [rankdir=LR, splines=true, nodesep=0.16, ranksep=0.52, fontname="Helvetica", fontsize=9,
         bgcolor="white", pad=0.10];
  node [fontname="Helvetica", fontsize=7.5, shape=plaintext];
  edge [fontname="Helvetica", fontsize=7, color="#333333", arrowsize=0.55,
        dir=both, arrowtail=tee, arrowhead=crow];
  // Physical SQLite schema. The logical model is docs/figures/prd-er.dot.
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
      <TR><TD BGCOLOR="#e6e6e6" COLSPAN="2"><B>users</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">verified_at</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>>];
  verification_codes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
      <TR><TD BGCOLOR="#e6e6e6" COLSPAN="2"><B>verification_codes</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">purpose</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">code_hash</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">consumed_at</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>>];
  login_sessions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
      <TR><TD BGCOLOR="#e6e6e6" COLSPAN="2"><B>login_sessions</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">last_seen_at</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>>];
  conversations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
      <TR><TD BGCOLOR="#e6e6e6" COLSPAN="2"><B>conversations</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>>];
  messages [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
      <TR><TD BGCOLOR="#e6e6e6" COLSPAN="2"><B>messages</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">conversation_id</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">sequence</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">content</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">provider</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">tier</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">reasoning</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">model</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">thinking</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>>];
  message_steps [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
      <TR><TD BGCOLOR="#e6e6e6" COLSPAN="2"><B>message_steps</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">message_id</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">position</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">step</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">detail</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">duration_ms</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">policy</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">rule_id</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>>];
  citations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
      <TR><TD BGCOLOR="#e6e6e6" COLSPAN="2"><B>citations</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">message_id</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">position</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">doc_id</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">page_no</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">quoted_span</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">bbox_norm</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">verified_at</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>>];
  tool_calls [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
      <TR><TD BGCOLOR="#e6e6e6" COLSPAN="2"><B>tool_calls</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">message_id</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">position</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">command_json</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">exit_code</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">output</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">tool_call_id</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">arguments_json</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">result_json</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">duration_ms</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>>];
  message_events [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
      <TR><TD BGCOLOR="#e6e6e6" COLSPAN="2"><B>message_events</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">message_id</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">position</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">reasoning</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">tool_call_position</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">step_id</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>>];
  knowledge_builds [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
      <TR><TD BGCOLOR="#e6e6e6" COLSPAN="2"><B>knowledge_builds</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">state</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">request_json</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">job_id</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">records_path</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">records_count</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">error</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>>];
  kb_folders [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
      <TR><TD BGCOLOR="#e6e6e6" COLSPAN="2"><B>kb_folders</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">parent_id</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">position</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">deleted_at</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>>];
  kb_documents [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
      <TR><TD BGCOLOR="#e6e6e6" COLSPAN="2"><B>kb_documents</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">folder_id</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">filename</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">pdf_sha256</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">byte_size</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">page_count</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">chunk_count</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">pdf_path</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">thumbnail_path</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">summary</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">summary_model</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">summary_created_at</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">status_detail</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">indexed_at</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">deleted_at</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>>];
  kb_chunks [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
      <TR><TD BGCOLOR="#e6e6e6" COLSPAN="2"><B>kb_chunks</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">doc_id</TD><TD ALIGN="LEFT">FK</TD></TR>
      <TR><TD ALIGN="LEFT">page_no</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">chunk_index</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">section</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">embed_text</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">block_ids</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">bbox_norm</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">token_estimate</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">oversize</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">embedding</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">embedding_model</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">chunker_version</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>>];
  kb_chunks_fts [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
      <TR><TD BGCOLOR="#e6e6e6" COLSPAN="2"><B>kb_chunks_fts</B></TD></TR>
      <TR><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">section</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>>];
  kb_index_state [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white">
      <TR><TD BGCOLOR="#e6e6e6" COLSPAN="2"><B>kb_index_state</B></TD></TR>
      <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">chunks</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">dimension</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">model</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">chunker_version</TD><TD ALIGN="LEFT"></TD></TR>
      <TR><TD ALIGN="LEFT">built_at</TD><TD ALIGN="LEFT"></TD></TR>
    </TABLE>>];
  users -> verification_codes [label="user_id"];
  users -> login_sessions [label="user_id"];
  users -> conversations [label="user_id"];
  conversations -> messages [label="conversation_id"];
  messages -> message_steps [label="message_id"];
  messages -> citations [label="message_id"];
  messages -> tool_calls [label="message_id"];
  messages -> message_events [label="message_id"];
  users -> knowledge_builds [label="user_id"];
  kb_folders -> kb_folders [label="parent_id"];
  kb_folders -> kb_documents [label="folder_id"];
  kb_documents -> kb_chunks [label="doc_id"];
}
